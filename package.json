{
    "name": "cord",
    "private": "true",
    "version": "1.0.0",
    "description": "The least cute Discord client mod",
    "homepage": "https://github.com/ItsFelix5/Cord#readme",
    "bugs": {
        "url": "https://github.com/ItsFelix5/Cord/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ItsFelix5/Cord.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "ItsFelix5",
    "scripts": {
        "build": "node build.mjs",
        "dev": "pnpm build --watch",
        "lint": "eslint"
    },
    "dependencies": {
        "@vap/core": "0.0.12",
        "@vap/shiki": "0.10.5",
        "fflate": "^0.8.2",
        "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^2.6.1",
        "@types/diff": "^5.2.1",
        "@types/lodash": "^4.17.7",
        "@types/node": "^22.0.3",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "diff": "^5.2.0",
        "discord-types": "^1.3.26",
        "esbuild": "^0.15.18",
        "eslint": "^9.8.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-path-alias": "2.1.0",
        "eslint-plugin-simple-header": "^1.1.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.0.1",
        "highlight.js": "10.7.3",
        "html-minifier-terser": "^7.2.0",
        "moment": "^2.30.1",
        "stylelint": "^16.8.1",
        "stylelint-config-standard": "^36.0.1",
        "ts-pattern": "^5.3.1",
        "tsx": "^4.16.5",
        "type-fest": "^4.23.0",
        "typescript": "^5.5.4",
        "typescript-eslint": "^8.0.0",
        "typescript-transform-paths": "^3.4.7"
    },
    "packageManager": "pnpm@9.1.0",
    "pnpm": {
        "patchedDependencies": {
            "eslint@9.8.0": "patches/eslint@9.8.0.patch",
            "eslint-plugin-path-alias@2.1.0": "patches/eslint-plugin-path-alias@2.1.0.patch"
        },
        "peerDependencyRules": {
            "ignoreMissing": [
                "eslint-plugin-import",
                "eslint"
            ]
        },
        "allowedDeprecatedVersions": {
            "source-map-resolve": "*",
            "resolve-url": "*",
            "source-map-url": "*",
            "urix": "*"
        }
    },
    "webExt": {
        "artifactsDir": "./dist",
        "build": {
            "overwriteDest": true
        },
        "sourceDir": "./dist/firefox-unpacked"
    },
    "engines": {
        "node": ">=18",
        "pnpm": ">=9"
    }
}
